APP_ENV=development
APP_NAME=Totem API
API_V1_PREFIX=/api/v1
SECRET_KEY=change-this-to-a-long-random-value
DATABASE_URL=sqlite:///./data/app.db
CORS_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=/api/v1
OPENAI_API_KEY=
# Production only: leave OPENAI_API_KEY empty and use an encrypted SSM SecureString.
OPENAI_API_KEY_PARAMETER_NAME=
AWS_REGION=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_PROMPT_COMPILER_MODEL=gpt-5-mini
USE_PROMPT_COMPILER=1
GENERATION_HOURLY_LIMIT=10
GENERATION_DAILY_LIMIT=30
GENERATION_STALE_MINUTES=10
IMAGE_STORAGE_ROOT=backend/data/images
IMAGE_MAX_BYTES=20000000
IMAGE_MAX_DIMENSION=8192
IMAGE_MAX_PIXELS=40000000
IMAGE_MIN_FREE_BYTES=2147483648
IMAGE_MIN_FREE_PERCENT=20
DATA_RETENTION_MINUTES=20160
SESSION_COOKIE_NAME=totem_session
SESSION_TTL_MINUTES=480
SESSION_COOKIE_SECURE=false
LOGIN_FAILURE_LIMIT=5
LOGIN_FAILURE_WINDOW_MINUTES=15
